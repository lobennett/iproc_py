Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Logan Bennett
    Description iProc v2.6 preprocessing pipeline container
    Version 1.2.0
    iProc_Version v2.6.0-beta.4

%help
    iProc preprocessing pipeline container for neuroimaging data.

    FSL: a single working install — 6.0.7 (conda build). iProc's runscripts
    request 4.0.3/5.0.4/5.0.10/6.0.1 per step via `module load`; all of those
    are symlinked onto /opt/fsl-6.0.7. The old centos5/6 binaries are NOT
    installed because their FNIRT crashes (NEWMAT SingularException) on a
    modern base OS; 6.0.7 runs correctly and emits decimal .mat matrices.

    Also: FreeSurfer 6.0.0, AFNI 16.3.13, ANTs 2.4.4, Python 3.11 + tedana,
    GNU Parallel, dcm2niix, ImageMagick, Connectome Workbench 1.3.2.

    Usage (source the module shim + venv inside a bash -c so `module` and the
    console `iproc` entry point are both defined):
      apptainer exec --bind /path/to/data:/data iproc.sif \
        bash -c "source /opt/module_shim.sh && \
                 source /opt/iproc-venv/bin/activate && \
                 iproc -c /data/config.cfg -s setup --bids /data/bids/sub-XX --executor local"

    Why the `bash -c "source /opt/module_shim.sh && ..."` wrapper is REQUIRED:
    iProc runs FSL via `subprocess(shell=True)` -> `/bin/sh -c "module load
    fsl/X && <cmd>"`. `module` is made available to those inner shells by the
    EXPORTED bash FUNCTION (`export -f module` in module_shim.sh): a parent
    `bash` that has sourced the shim exports the function into the environment,
    and child shells (/bin/sh is bash here) import it. It is NOT delivered via
    BASH_ENV — bash invoked as `sh` (non-interactive) does not read BASH_ENV.
    Consequently a bare `apptainer exec CONTAINER <python> ...` (or
    `apptainer exec CONTAINER iproc ...`) with no sourcing bash parent leaves
    `module` undefined and is unsupported; always go through the sourcing
    `bash -c` above.

# ============================================================================
# FILES — only the module shim and FreeSurfer license need pre-staging
# ============================================================================
%files
    module_shim.sh /opt/module_shim.sh
    flirt_wrapper.sh /opt/flirt_wrapper.sh
    convert_xfm_wrapper.sh /opt/convert_xfm_wrapper.sh
    downloads/license.txt /opt/freesurfer-6.0.0/license.txt
    # Staged here; %post copies it over the ImageMagick package default AFTER
    # imagemagick is apt-installed (a %files copy to /etc would be clobbered by
    # the apt install). Raises memory/disk/area + list-length so iProc's
    # many-run QC `convert -adjoin` PDFs work without a runtime --bind.
    imagemagick-policy.xml /opt/imagemagick-policy.xml
    # If you have exact FSL versions from Sherlock, uncomment and add:
    # downloads/fsl-4.0.3.tar.gz /tmp/fsl-sherlock-4.0.3.tar.gz
    # downloads/fsl-5.0.4.tar.gz /tmp/fsl-sherlock-5.0.4.tar.gz
    # downloads/fsl-5.0.10.tar.gz /tmp/fsl-sherlock-5.0.10.tar.gz

# ============================================================================
# POST — install everything
# ============================================================================
%post -c /bin/bash
    set -eu

    # ============================================================================
    # PINNED VERSIONS — reproducibility manifest for this container build.
    # The neuroimaging toolchain and the *core* iProc Python deps below are
    # pinned to an explicit version and source URL, with two honest caveats:
    #   - AFNI has no dated/versioned Linux binary tarball upstream; see the
    #     "AFNI VERSION PINNING NOTE" in section 6 for the justification and
    #     the build-time provenance capture used instead.
    #   - The multi-echo tedana stack (scikit-learn, nilearn, mapca, bokeh,
    #     robustica, seaborn, threadpoolctl, joblib, pybtex, tqdm, …) and the
    #     base apt packages are NOT fully version-pinned (see section 10:
    #     tedana + its transitive deps are installed unpinned, only numpy/scipy
    #     are held to exact versions). Multi-echo/ICA output is therefore not
    #     guaranteed byte-reproducible across rebuilds — a known reproducibility
    #     caveat, not an exact pinning. Only numpy/scipy/nibabel/PyYAML and the
    #     other core deps in the first `pip install` block are exact-pinned.
    #
    #   Tool                        Version          Source
    #   --------------------------  ---------------  ------------------------------------------------------------
    #   Python                      3.11             deadsnakes PPA (ppa:deadsnakes/ppa)
    #   GNU Parallel                Ubuntu 22.04 apt  apt package "parallel"
    #   dcm2niix                    v1.0.20230411    github.com/rordenlab/dcm2niix/releases/download/v1.0.20230411/
    #   FSL (ALL versions -> 6.0.7) 6.0.7+ (conda)   fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py
    #      (old centos 4.1.9/5.0.8 tarballs dropped: their fnirt is broken on a
    #       modern base OS; every iProc version request is symlinked to 6.0.7)
    #   FreeSurfer                  6.0.0            surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/6.0.0/freesurfer-Linux-centos6_x86_64-stable-pub-v6.0.0.tar.gz
    #   AFNI                        latest-stable*   afni.nimh.nih.gov/pub/dist/tgz/linux_openmp_64.tgz  (*see note in section 6)
    #   ANTs                        2.4.4            github.com/ANTsX/ANTs/releases/download/v2.4.4/ants-2.4.4-ubuntu-22.04-X64-gcc.zip
    #   Connectome Workbench        2.1.0            humanconnectome.org/storage/app/media/workbench/workbench-linux64-v2.1.0.zip
    #   MRIcroGL                    v1.2.20190902    github.com/rordenlab/MRIcroGL/releases/download/v1.2.20190902/MRIcroGL_linux.zip
    #   Core Python deps            exact-pinned     first `pip install` block below (numpy==1.25.2, scipy==1.16.3, nibabel==5.3.3, PyYAML==5.2, etc.)
    #   tedana + ICA stack          NOT pinned       section 10 second block (scikit-learn, nilearn, mapca, bokeh, robustica, seaborn, …) — reproducibility caveat
    #
    # All URLs above were verified reachable (HTTP 200) as of 2026-07-05.
    # ============================================================================

    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    # ------------------------------------------------------------------
    # 1. System packages
    # ------------------------------------------------------------------
    apt-get update && apt-get install -y --no-install-recommends \
        bc \
        bzip2 \
        ca-certificates \
        curl \
        dc \
        file \
        gcc \
        g++ \
        ghostscript \
        git \
        imagemagick \
        libc6 \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libglu1-mesa \
        libgomp1 \
        libice6 \
        libopenblas-dev \
        libpng16-16 \
        libquadmath0 \
        libsm6 \
        libx11-6 \
        libxext6 \
        libxi6 \
        libxmu6 \
        libxrender1 \
        libxss1 \
        libxt6 \
        locales \
        software-properties-common \
        tcsh \
        unzip \
        wget \
        xvfb \
        libxft2 \
        rsync \
        zlib1g-dev \
    && locale-gen en_US.UTF-8 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install Python 3.11 (required: numpy==1.25.2 needs <=3.11, scipy==1.16.3 needs >=3.11)
    apt-get update && apt-get install -y --no-install-recommends gpg gpg-agent
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3.11-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1

    # Make /bin/sh point to bash. This is required so that iProc's
    # subprocess(shell=True) -> `/bin/sh -c "module load fsl/X && cmd"` calls
    # can see `module`: the shim EXPORTS a bash function (`export -f module`),
    # and bash (even invoked as `sh`) imports exported functions from the
    # environment, whereas a POSIX-only /bin/sh (e.g. dash) would not. NOTE:
    # this is NOT about BASH_ENV — bash invoked as `sh` non-interactively does
    # NOT read BASH_ENV; delivery is via the inherited exported function from a
    # parent bash that sourced the shim (see %runscript / %help).
    ln -sf /bin/bash /bin/sh

    # ------------------------------------------------------------------
    # 2. GNU Parallel (use apt package — building from source fails in fakeroot)
    # ------------------------------------------------------------------
    echo "=== Installing GNU Parallel ==="
    apt-get update && apt-get install -y --no-install-recommends parallel \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
    mkdir -p /root/.parallel && touch /root/.parallel/will-cite

    # ------------------------------------------------------------------
    # 3. dcm2niix 1.0.20230411
    # ------------------------------------------------------------------
    echo "=== Installing dcm2niix ==="
    cd /tmp
    curl -fsSL "https://github.com/rordenlab/dcm2niix/releases/download/v1.0.20230411/dcm2niix_lnx.zip" \
        -o dcm2niix.zip
    unzip dcm2niix.zip -d /usr/local/bin/
    chmod +x /usr/local/bin/dcm2niix
    rm -f dcm2niix.zip

    # ------------------------------------------------------------------
    # 4. FSL 6.0.7 — the single, working FSL for the whole pipeline
    # ------------------------------------------------------------------
    # iProc's runscripts request FSL 4.0.3 / 5.0.4 / 5.0.10 / 6.0.1 per step
    # via `module load`. Those exact versions are only distributed as old
    # centos5/6 binary tarballs, and on a modern base OS several of their tools
    # — notably FNIRT — crash with NEWMAT/armadillo `inv(): matrix is singular`
    # / SingularException on ANY input (confirmed empirically: FSL 5.0.4/5.0.8/
    # 5.0.10 fnirt all abort on a stock MNI152->MNI152 registration; only
    # 6.0.x/4.1.9 run). So the faithful multi-version install is unachievable
    # here. We install ONLY FSL 6.0.7 (conda build, ships its own libs, fully
    # working) and map every version iProc requests onto it via symlinks below.
    # This changes the FSL version relative to upstream for every step, but the
    # old binaries do not run at all, so there is no working alternative; and
    # 6.0.7 emits decimal .mat matrices, sidestepping the hex-float parsing
    # pitfall entirely.
    echo "=== Installing FSL 6.0.7 via conda installer (single FSL for all versions) ==="
    cd /tmp
    curl -fsSL "https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py" \
        -o fslinstaller.py
    python3 fslinstaller.py -d /opt/fsl-6.0.7 --cuda none 2>&1
    rm -f fslinstaller.py
    # Only create the 6.0.1 mapping symlink if the install actually produced a
    # usable FSL tree — do NOT mask a failed install with `|| true` + an
    # unconditional symlink (that yields a dangling 6.0.1 -> empty 6.0.7).
    if [[ ! -x /opt/fsl-6.0.7/bin/flirt ]]; then
        echo "ERROR: FSL 6.0.7 install failed — /opt/fsl-6.0.7/bin/flirt not found"
        ls -la /opt/fsl-6.0.7/bin/ 2>/dev/null || true
        exit 1
    fi
    # Map every FSL version iProc's runscripts / module_shim request onto the
    # single working 6.0.7 install. module_shim's `module load fsl/X` sets
    # FSLDIR=/opt/fsl-X, and iProc/cfg paths reference /opt/fsl-X/data/... —
    # all of these now resolve through the symlink to the real 6.0.7 tree.
    for v in 4.0.3 4.1.9 5.0.4 5.0.8 5.0.10 6.0.1; do
        ln -sf /opt/fsl-6.0.7 /opt/fsl-${v}
    done
    if [[ -d /opt/fsl-6.0.7 ]] && [[ ! -L /opt/fsl-6.0.7 ]]; then
        mkdir -p /opt/fsl-6.0.7/etc/fslconf
        if [[ ! -f /opt/fsl-6.0.7/etc/fslconf/fsl.sh ]]; then
            cat > /opt/fsl-6.0.7/etc/fslconf/fsl.sh <<'FSLEOF'
FSLDIR=/opt/fsl-6.0.7
FSLOUTPUTTYPE=NIFTI_GZ
export FSLDIR FSLOUTPUTTYPE
FSLEOF
        fi
    fi

    # ------------------------------------------------------------------
    # 4b. Activate the hex-float flirt/convert_xfm wrappers (ALWAYS-ON)
    # ------------------------------------------------------------------
    # FSL 5.0.x can emit affine .mat matrices in C99 hex-float notation
    # (0x1.abcdp+0) that the rest of FSL then parses as 0.0 — producing
    # all-zero matrices and NEWMAT::SingularException downstream. The wrapper
    # scripts (container/flirt_wrapper.sh, convert_xfm_wrapper.sh) run the
    # real binary, then rewrite any -omat output that is *genuinely*
    # hex-float into decimal. Because they only convert true C99 hex-float
    # tokens (0x/0X AND a p/P exponent) and leave decimal matrices
    # byte-for-byte untouched, baking them in is safe even if this FSL build
    # actually emits decimal — the fix (see hex-float fix #1) becomes an
    # always-active no-op in that case rather than dead, unwired code.
    #
    # We wrap EVERY real (non-symlink) FSL install that actually ships the
    # affected binaries — not just the default /opt/fsl-5.0.10. This matters
    # for the "exact-from-Sherlock tarball" path (CON#4 / I-g): there
    # /opt/fsl-5.0.4 and /opt/fsl-5.0.10 are SEPARATE real directories, so
    # wrapping only 5.0.10 would leave 5.0.4/bin/{flirt,convert_xfm}
    # unwrapped and the hex-float bug live in the most-rigorous validation
    # path. For each real FSL dir we move the real binary aside to
    # `<tool>.real` in the SAME bin/ dir and install the wrapper in its place;
    # the wrapper locates its sibling `<tool>.real` generically, so each FSL
    # version calls its own real binary.
    # Idempotent: a dir is skipped if `<tool>.real` already exists.
    #
    # NOTE: whether this FSL build actually emits hex-float .mat files is a
    # Phase-B verification item (see docs/validation.md); the wrapper is
    # correct and harmless either way.
    echo "=== Activating hex-float flirt/convert_xfm wrappers ==="
    for fsldir in /opt/fsl-4.0.3 /opt/fsl-4.1.9 /opt/fsl-5.0.4 /opt/fsl-5.0.8 /opt/fsl-5.0.10 /opt/fsl-6.0.7; do
        # Only real dirs (skip the mapping symlinks so we wrap each backing
        # install exactly once) that actually contain BOTH affected binaries.
        [[ -d "$fsldir" ]] && [[ ! -L "$fsldir" ]] || continue
        [[ -f "${fsldir}/bin/flirt" || -f "${fsldir}/bin/flirt.real" ]] || continue
        [[ -f "${fsldir}/bin/convert_xfm" || -f "${fsldir}/bin/convert_xfm.real" ]] || continue
        for tool in flirt convert_xfm; do
            realbin="${fsldir}/bin/${tool}.real"
            if [[ -f "${fsldir}/bin/${tool}" ]] && [[ ! -e "$realbin" ]]; then
                mv "${fsldir}/bin/${tool}" "$realbin"
                cp "/opt/${tool}_wrapper.sh" "${fsldir}/bin/${tool}"
                chmod +x "${fsldir}/bin/${tool}"
                echo "  wrapped ${fsldir}/bin/${tool}: real binary -> ${realbin}"
            else
                echo "  skip ${fsldir}/bin/${tool} (missing or already wrapped: ${realbin})"
            fi
        done
    done

    # ------------------------------------------------------------------
    # 5. FreeSurfer 6.0.0
    # ------------------------------------------------------------------
    echo "=== Installing FreeSurfer 6.0.0 ==="
    mkdir -p /opt/freesurfer-6.0.0
    cd /tmp
    curl -fSL "https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/6.0.0/freesurfer-Linux-centos6_x86_64-stable-pub-v6.0.0.tar.gz" \
        -o freesurfer.tar.gz
    tar xzf freesurfer.tar.gz -C /opt/freesurfer-6.0.0 --strip-components=1
    rm -f freesurfer.tar.gz
    # license.txt already copied via %files

    # ------------------------------------------------------------------
    # 5b. FreeSurfer 7.4.1 (--braga: recon-all + mri_synthstrip)
    # ------------------------------------------------------------------
    # Braga uses FS 7.1, but mri_synthstrip (our portable skull-strip
    # substitute for Braga's private U-Net) was added in FS 7.3.0, so we ship
    # 7.4.1 to serve BOTH recon-all and SynthStrip from one install. FS 6.0.0
    # stays the DEFAULT (upstream-identical path); 7.4.1 is selected only via
    # the [BRAGA] FS_VERSION / FREESURFER_HOME cfg (Phase 1c wiring).
    echo "=== Installing FreeSurfer 7.4.1 (--braga) ==="
    mkdir -p /opt/freesurfer-7.4.1
    cd /tmp
    curl -fSL "https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/7.4.1/freesurfer-linux-ubuntu22_amd64-7.4.1.tar.gz" \
        -o fs741.tar.gz
    # FS 7.4.1 tarball entries are prefixed "./freesurfer/..." (GNU tar counts
    # "." as a component), so strip 2 to land bin/ at the root — unlike FS 6.0.0
    # above whose entries are "freesurfer/..." and need strip 1.
    tar xzf fs741.tar.gz -C /opt/freesurfer-7.4.1 --strip-components=2
    rm -f fs741.tar.gz
    cp /opt/freesurfer-6.0.0/license.txt /opt/freesurfer-7.4.1/license.txt
    test -f /opt/freesurfer-7.4.1/bin/mri_synthstrip \
        && echo "  mri_synthstrip present (FS 7.4.1)" \
        || { echo "ERROR: mri_synthstrip missing from FS 7.4.1"; exit 1; }

    # ------------------------------------------------------------------
    # 5c. R + jsonlite (--braga slice-timing: slicetiming_tool.R)
    # ------------------------------------------------------------------
    # Braga's slice-timing step is an R script whose only dependency is
    # jsonlite (reads BIDS SliceTiming). Installed now so Phase 2 needs no
    # further container rebuild; the .R script itself is vendored in Phase 2.
    echo "=== Installing R + jsonlite (--braga slice-timing) ==="
    apt-get update && apt-get install -y --no-install-recommends r-base-core r-cran-jsonlite \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
    Rscript -e 'library(jsonlite); cat("  R + jsonlite OK\n")' \
        || { echo "ERROR: R/jsonlite verification failed"; exit 1; }

    # ------------------------------------------------------------------
    # 6. AFNI (pre-built binaries)
    # ------------------------------------------------------------------
    # Note: AFNI_ARCHIVE/AFNI_16.3.13.tgz is SOURCE CODE, not binaries.
    # Use the pre-built binary distribution instead (latest stable).
    #
    # AFNI VERSION PINNING NOTE:
    #   AFNI does not publish dated/versioned tarballs for its Linux binary
    #   distribution — only a rolling "latest" tgz per platform is served at
    #   a fixed URL (verified against the directory listing at
    #   https://afni.nimh.nih.gov/pub/dist/tgz/ on 2026-07-05: no per-version
    #   linux_openmp_64 archive exists, unlike the macOS builds which do get
    #   versioned filenames, e.g. macos_12_x86_64.AFNI_25.3.03.tgz).
    #   iProc's own AFNI usage is limited to 3dTproject and 3dAFNItoNIFTI,
    #   both long-stable, narrowly-scoped utilities whose I/O behavior has
    #   not changed across recent AFNI releases, so we intentionally track
    #   AFNI's "latest stable" Linux build rather than block reproducibility
    #   work on a pin that upstream does not offer.
    #   As partial mitigation, the build below captures build-time
    #   provenance: the HTTP Last-Modified/ETag of the downloaded tarball
    #   (recorded to /opt/afni-download-provenance.txt) and the actual
    #   installed `afni -version` string (recorded to
    #   /opt/afni/INSTALLED_VERSION.txt), so any given image can be audited
    #   after the fact for exactly which AFNI build it contains.
    #   Verified at doc time (2026-07-05): the tarball's HTTP Last-Modified
    #   header was "Wed, 01 Jul 2026 22:38:21 GMT".
    echo "=== Installing AFNI (pre-built binaries; see AFNI VERSION PINNING NOTE above) ==="
    mkdir -p /opt/afni
    cd /tmp
    curl --retry 3 -fSL -D afni_headers.txt "https://afni.nimh.nih.gov/pub/dist/tgz/linux_openmp_64.tgz" \
        -o afni.tgz
    echo "  AFNI tarball HTTP headers (build-time provenance):"
    grep -i "^last-modified\|^etag" afni_headers.txt || true
    grep -i "^last-modified\|^etag" afni_headers.txt > /opt/afni-download-provenance.txt || true
    rm -f afni_headers.txt
    tar xzf afni.tgz -C /opt/afni --strip-components=1
    rm -f afni.tgz
    echo "  AFNI installed: $(ls /opt/afni/ | wc -l) files"
    # Record the actual installed AFNI version for provenance/debugging.
    timeout 15 /opt/afni/afni -version > /opt/afni/INSTALLED_VERSION.txt 2>&1 \
        || echo "unknown (afni -version failed or timed out)" > /opt/afni/INSTALLED_VERSION.txt
    echo "  AFNI installed version: $(cat /opt/afni/INSTALLED_VERSION.txt)"

    # ------------------------------------------------------------------
    # 6b. AFNI legacy runtime libraries (libpng12, libXp)
    # ------------------------------------------------------------------
    # AFNI's linux_openmp_64 binaries link libpng12.so.0, libXft.so.2 and
    # libXp.so.6. libXft.so.2 is installed via apt (libxft2, section 1).
    # libpng12 and libXp were dropped from Ubuntu 22.04, so fetch the amd64
    # .debs from snapshot.debian.org (permanent archive) and extract the .so
    # files directly with `dpkg-deb -x` — no dpkg dependency resolution, no
    # multiarch-support needed. Without these, EVERY AFNI tool (3dTproject,
    # 3dBandpass) fails at load; first surfaced in filter_and_project. The
    # neurodocker recipe (ReproNim/neurodocker#419) uses these libs; its
    # original mirror URLs 404 now, so we pin snapshot.debian.org.
    echo "=== Installing AFNI legacy runtime libs (libpng12, libXp) ==="
    cd /tmp
    curl -fsSL --retry 5 -o libxp6.deb \
        "http://snapshot.debian.org/archive/debian/20141009T042436Z/pool/main/libx/libxp/libxp6_1.0.2-2_amd64.deb"
    curl -fsSL --retry 5 -o libpng12.deb \
        "http://snapshot.debian.org/archive/debian-security/20160113T213056Z/pool/updates/main/libp/libpng/libpng12-0_1.2.49-1%2Bdeb7u2_amd64.deb"
    # Extract to temp dirs and copy ONLY the .so files into the multiarch lib
    # dir. Do NOT `dpkg-deb -x <deb> /`: the libpng12 deb ships a pre-merged-usr
    # "./lib/x86_64-linux-gnu/" path, and extracting it through Ubuntu 22.04's
    # merged-usr /lib symlink clobbers the linker's libc path — /bin/sh then
    # fails to load and the build dies at the next ldconfig (exit 126).
    rm -rf /tmp/xp /tmp/png && mkdir -p /tmp/xp /tmp/png
    dpkg-deb -x libxp6.deb /tmp/xp
    dpkg-deb -x libpng12.deb /tmp/png
    cp -a /tmp/xp/usr/lib/x86_64-linux-gnu/libXp.so.* /usr/lib/x86_64-linux-gnu/
    cp -a /tmp/png/lib/x86_64-linux-gnu/libpng12.so.* /usr/lib/x86_64-linux-gnu/
    ldconfig
    rm -rf /tmp/libxp6.deb /tmp/libpng12.deb /tmp/xp /tmp/png
    # Fail the build now if any AFNI tool still has unresolved libs.
    if ldd /opt/afni/3dTproject | grep -q "not found"; then
        echo "ERROR: AFNI 3dTproject still has unresolved libraries:"
        ldd /opt/afni/3dTproject | grep "not found"
        exit 1
    fi
    echo "  AFNI 3dTproject libraries all resolved"

    # ------------------------------------------------------------------
    # 7. ANTs 2.4.4
    # ------------------------------------------------------------------
    echo "=== Installing ANTs 2.4.4 ==="
    mkdir -p /opt/ants
    cd /tmp
    curl -fSL "https://github.com/ANTsX/ANTs/releases/download/v2.4.4/ants-2.4.4-ubuntu-22.04-X64-gcc.zip" \
        -o ants.zip
    unzip ants.zip -d /opt/ants-tmp
    # ANTs releases have varying directory structures; flatten to /opt/ants
    if [[ -d /opt/ants-tmp/ants-2.4.4 ]]; then
        cp -a /opt/ants-tmp/ants-2.4.4/* /opt/ants/
    else
        cp -a /opt/ants-tmp/*/* /opt/ants/ 2>/dev/null || cp -a /opt/ants-tmp/* /opt/ants/
    fi
    rm -rf /opt/ants-tmp ants.zip

    # ------------------------------------------------------------------
    # 8. Connectome Workbench (pinned: v2.1.0 — v1.3.2 no longer distributed)
    #    Note: wb_command is not actively used by iProc but included
    #    for potential future use and general neuroimaging utility.
    #    URL verified reachable (HTTP 200) on 2026-07-05.
    # ------------------------------------------------------------------
    echo "=== Installing Connectome Workbench 2.1.0 ==="
    cd /tmp
    curl -fSL "https://www.humanconnectome.org/storage/app/media/workbench/workbench-linux64-v2.1.0.zip" \
        -o workbench.zip
    unzip workbench.zip -d /opt/
    rm -f workbench.zip

    # ------------------------------------------------------------------
    # 9. MRIcroGL (pinned: v1.2.20190902, a versioned GitHub release tag)
    #    URL verified reachable (HTTP 200) on 2026-07-05.
    # ------------------------------------------------------------------
    echo "=== Installing MRIcroGL v1.2.20190902 ==="
    cd /tmp
    curl -fSL "https://github.com/rordenlab/MRIcroGL/releases/download/v1.2.20190902/MRIcroGL_linux.zip" \
        -o mricrogl.zip
    unzip mricrogl.zip -d /opt/
    rm -f mricrogl.zip

    # ------------------------------------------------------------------
    # 10. Python virtual environment + iProc deps + tedana
    # ------------------------------------------------------------------
    echo "=== Setting up Python environment ==="
    python3.11 -m venv /opt/iproc-venv
    . /opt/iproc-venv/bin/activate
    pip install --upgrade pip setuptools wheel

    # Install numpy and scipy first with exact pins
    pip install "numpy==1.25.2" "scipy==1.16.3"

    # Install remaining iProc dependencies
    pip install \
        "nibabel==5.3.3" \
        "texttable==0.8.4" \
        "paramiko==3.3.1" \
        "matplotlib==3.10.8" \
        "PyYAML==5.2" \
        "yaxil==0.13.1" \
        "configparser==3.5.0"

    # Install tedana and ALL its deps with numpy/scipy constrained
    pip install --no-deps tedana
    pip install "numpy==1.25.2" "scipy==1.16.3" \
        scikit-learn mapca threadpoolctl joblib nilearn bokeh \
        pybtex pybtex-apa-style robustica seaborn tqdm

    # Verify numpy version wasn't overridden
    NP_VER=$(python3 -c 'import numpy; print(numpy.__version__)')
    echo "  numpy version: ${NP_VER}"
    echo "  scipy version: $(python3 -c 'import scipy; print(scipy.__version__)')"
    if [[ "$NP_VER" != "1.25.2" ]]; then
        echo "ERROR: numpy was overridden to ${NP_VER}, expected 1.25.2"
        exit 1
    fi

    deactivate

    # ------------------------------------------------------------------
    # 11. Module shim setup
    # ------------------------------------------------------------------
    chmod +x /opt/module_shim.sh
    cp /opt/module_shim.sh /etc/profile.d/module_shim.sh

    # Install the QC-friendly ImageMagick policy over the package default (now
    # that imagemagick is installed). Cover IM6 and IM7 locations if present.
    for pol in /etc/ImageMagick-6/policy.xml /etc/ImageMagick-7/policy.xml; do
        [[ -d "$(dirname "$pol")" ]] && cp /opt/imagemagick-policy.xml "$pol" && echo "  installed policy -> $pol"
    done

    # ------------------------------------------------------------------
    # 12. Create bind-mount points for Sherlock HPC
    # ------------------------------------------------------------------
    mkdir -p /scratch /oak /data /bids /home

    echo "=== Build complete ==="

# ============================================================================
# ENVIRONMENT
# ============================================================================
%environment
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8

    # BASH_ENV lets *non-interactive bash* (`bash -c ...`, NOT bash invoked as
    # `sh`) source the shim automatically. It does NOT deliver `module` to
    # iProc's subprocess(shell=True) -> `/bin/sh -c` calls (bash-as-sh ignores
    # BASH_ENV); that path relies on the exported bash function inherited from
    # a parent bash that sourced the shim (see %runscript / %help). Kept as a
    # convenience for interactive/`bash -c` use only.
    export BASH_ENV=/opt/module_shim.sh

    # Single working FSL for all steps (6.0.7; all iProc version requests are
    # symlinked onto it — the old 5.0.x binaries' fnirt is broken on this base OS)
    export FSLDIR=/opt/fsl-6.0.7
    export FSLOUTPUTTYPE=NIFTI_GZ
    export FSLMULTIFILEQUIT=TRUE

    # FreeSurfer
    export FREESURFER_HOME=/opt/freesurfer-6.0.0
    export SUBJECTS_DIR=/opt/freesurfer-6.0.0/subjects
    export FS_LICENSE=/opt/freesurfer-6.0.0/license.txt

    # AFNI
    export AFNI_HOME=/opt/afni

    # ANTs
    export ANTSPATH=/opt/ants/bin
    export ANTS_HOME=/opt/ants

    # Connectome Workbench
    export CARET7DIR=/opt/workbench/bin_linux64

    # Python venv
    export VIRTUAL_ENV=/opt/iproc-venv

    # PATH (FSLDIR/bin gets swapped by module shim at runtime)
    export PATH="/opt/iproc-venv/bin:${FSLDIR}/bin:${FREESURFER_HOME}/bin:${AFNI_HOME}:${ANTSPATH}:${CARET7DIR}:/opt/MRIcroGL:/usr/local/bin:/usr/bin:/bin"

    export PARALLEL_HOME=/tmp/.parallel

# ============================================================================
# RUNSCRIPT
# ============================================================================
%runscript
    source /opt/module_shim.sh
    source ${FREESURFER_HOME}/SetUpFreeSurfer.sh 2>/dev/null || true
    source /opt/iproc-venv/bin/activate
    mkdir -p /tmp/.parallel && touch /tmp/.parallel/will-cite
    exec "$@"

# ============================================================================
# STARTSCRIPT
# ============================================================================
%startscript
    source /opt/module_shim.sh
    source ${FREESURFER_HOME}/SetUpFreeSurfer.sh 2>/dev/null || true
    source /opt/iproc-venv/bin/activate
